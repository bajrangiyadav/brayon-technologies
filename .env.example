# BRAYON Technologies — Environment Variables Template
# Copy this file to ".env.local" and fill in real values.
# NEVER commit .env.local to version control.

# ----------------------------------------------------------------
# EMAIL NOTIFICATIONS (Nodemailer / Gmail App Password)
# Required to receive instant email alerts for new leads.
# Steps:
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Generate an App Password:   https://myaccount.google.com/apppasswords
# ----------------------------------------------------------------
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional: override the notification recipient
NOTIFICATION_EMAIL=your-email@gmail.com

# ----------------------------------------------------------------
# WHATSAPP INTEGRATION
# International format without +: e.g. 917385121432 for +91 73851 21432
# ----------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX

# ----------------------------------------------------------------
# SITE CONFIGURATION
# ----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://brayontech.com
